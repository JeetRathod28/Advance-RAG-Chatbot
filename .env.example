# ── LLM (Ollama — local) ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=300

# ── Web Search (Get your API key at tavily.com) ───────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Embedding (Local huggingface sentence-transformer model) ─────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Reranker (Local huggingface cross-encoder model) ─────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Retrieval ─────────────────────────────────────────────────────────────────
MAX_RETRIEVAL_K=30
RERANK_TOP_K=8
DOC_QUALITY_THRESHOLD=-1.0

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Paths ─────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./vector_store
DATA_PATH=./data
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
